# Credentials of the image profile "online", copied into the image
# (/etc/credstore, root only, read-only root filesystem): copy this file to
# image/credentials.toml, which git ignores. An image built with credentials
# must not be published: anyone with the image can read them.

[abusech]
# MalwareBazaar export (free account: https://auth.abuse.ch/)
auth_key = ""

[airgap]
# Copy of the verified keys to a server (docs/airgap.md), with [airgap] of
# packaging/pandora-box.toml.
# Private SSH key of the account on the server (rsync, sftp), for instance
# made with: ssh-keygen -t ed25519 -N "" -f airgap-ssh-key
ssh_key = """
"""
# Password of the account on the SMB server (smb)
password = ""
# Key that signs the identifiers written on the keys (.pandora-box), the
# same for every kiosk of the organization:
#   openssl genpkey -algorithm ed25519 -out airgap-token.key
token_key = """
"""
