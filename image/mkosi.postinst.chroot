#!/bin/sh
# Install usb-pasteur and its deployment files into the image.
set -eu

PACKAGING="$SRCDIR/usb-pasteur/packaging"

/usr/lib/usb-pasteur/bin/pip install --no-cache-dir --no-deps --no-index \
    /usr/share/usb-pasteur/wheels/usb_pasteur-*.whl
rm -r /usr/share/usb-pasteur/wheels
ln -sf /usr/lib/usb-pasteur/bin/usb-pasteur /usr/bin/usb-pasteur
ln -sf /usr/lib/usb-pasteur/bin/usb-pasteur-signatures /usr/bin/usb-pasteur-signatures
ln -sf /usr/lib/usb-pasteur/bin/usb-pasteur-image /usr/bin/usb-pasteur-image

# Public key trusted to sign signature sets (generated by build.sh for development)
install -D -m 0644 "$SRCDIR/usb-pasteur/image/update.pem" /usr/share/usb-pasteur/keys/update.pem

install -D -m 0644 "$PACKAGING/usb-pasteur.toml" /etc/usb-pasteur/usb-pasteur.toml

# Theme of the graphical interface (display.theme): the files of image/theme/,
# if the administrator made one (logo, colors, texts), else the built-in theme
THEME=/usr/share/usb-pasteur/theme
install -d -m 0755 "$THEME"
if [ -d "$SRCDIR/usb-pasteur/image/theme" ]; then
    cp -r "$SRCDIR/usb-pasteur/image/theme/." "$THEME/"
    chmod -R u=rwX,go=rX "$THEME"
fi
/usr/lib/usb-pasteur/bin/usb-pasteur-theme check "$THEME"
for unit in usb-pasteur.service usb-pasteur-update.service usb-pasteur-update.timer; do
    install -D -m 0644 "$PACKAGING/systemd/$unit" "/usr/lib/systemd/system/$unit"
done
install -D -m 0644 "$PACKAGING/tmpfiles/usb-pasteur.conf" /usr/lib/tmpfiles.d/usb-pasteur.conf
# The root filesystem is read-only: tmpfiles cannot create the mount point
install -d -m 0700 /media/usb-pasteur
install -D -m 0644 "$PACKAGING/logrotate/usb-pasteur" /etc/logrotate.d/usb-pasteur
# User of the sandboxed scan workers, created by systemd-sysusers at build time
install -D -m 0644 "$PACKAGING/sysusers/usb-pasteur.conf" /usr/lib/sysusers.d/usb-pasteur.conf

# clamd settings required by the ClamAV engine (docs/engines.md)
clamd_option() {
    if grep -q "^$1 " /etc/clamav/clamd.conf; then
        sed -i "s|^$1 .*|$1 $2|" /etc/clamav/clamd.conf
    else
        echo "$1 $2" >> /etc/clamav/clamd.conf
    fi
}
clamd_option LocalSocket /run/clamav/clamd.ctl
# The ClamAV databases of the installed signature set
clamd_option DatabaseDirectory /var/lib/usb-pasteur-signatures/current/clamav
clamd_option AlertExceedsMax true
clamd_option MaxFileSize 100M
clamd_option MaxScanSize 400M
clamd_option StreamMaxLength 100M
# No fuzzy hash of the images (ClamAV 1.0): it decodes every image, those
# of a PDF too, for a few signatures of known images (phishing). Half the
# time of a 29 MB PDF on the ThinkCentre: 43 s. The images are still scanned.
clamd_option ScanImageFuzzyHash no
# Encrypted archives and documents cannot be scanned: reported (the kiosk
# counts them as not fully scanned), not let through as clean
clamd_option AlertEncrypted yes
# Office documents with macros (VBA, also in .docm, .xlsm): suspicious
clamd_option AlertOLE2Macros yes

# USBGuard: the policy of mkosi.extra replaces the one generated by the
# package from the devices of the build machine; only root may use it
rm -f /etc/usbguard/IPCAccessControl.d/*
chmod 0600 /etc/usbguard/rules.conf /etc/usbguard/usbguard-daemon.conf

# The audit rules of mkosi.extra replace those of the package
rm -f /etc/audit/rules.d/audit.rules
chmod 0640 /etc/audit/audit.rules

# A keyboard cannot reboot the kiosk (Ctrl-Alt-Del)
systemctl mask ctrl-alt-del.target
