#!/bin/sh
# Runtime dependencies in a virtual environment, from the hash-pinned list.
# Prepare scripts run with network access; the result is cached by mkosi.
set -eu

if [ "$1" = final ]; then
    python3 -m venv /usr/lib/pandora-box
    /usr/lib/pandora-box/bin/pip install --no-cache-dir --require-hashes --only-binary :all: \
        -r "$SRCDIR/pandora-box/image/requirements.txt"
fi
