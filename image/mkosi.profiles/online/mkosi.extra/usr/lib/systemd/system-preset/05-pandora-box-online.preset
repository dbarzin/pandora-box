# Image profile "online": read before 10-pandora-box.preset, which disables
# the network
enable systemd-networkd.service
enable systemd-networkd.socket
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable pandora-box-update.timer
# Exits at once unless [siem] is enabled in the configuration
enable pandora-box-siem.service
# freshclam is run by the update service, as its user, through the firewall
disable clamav-freshclam.service
disable clamav-freshclam-once.timer
