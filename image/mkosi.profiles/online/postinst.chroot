#!/bin/sh
# Profile "online": the kiosk downloads the signatures from their sources,
# with the credentials of image/credentials.toml (outside git).
set -eu

# [updates] of the kiosk configuration: enabled, from every source
sed -i '/^\[updates\]/,/^\[/ {
    s/^enabled = false$/enabled = true/
    s/^sources = \[\]$/sources = ["clamav", "yara-forge", "malwarebazaar", "hashlookup"]/
}' /etc/pandora-box/pandora-box.toml

# Credentials: systemd credentials of the update service (ImportCredential=),
# root only, on the read-only root filesystem. Without the abuse.ch Auth-Key,
# MalwareBazaar is not downloaded (its database is kept from the last
# signature update device).
CREDENTIALS="$SRCDIR/pandora-box/image/credentials.toml"
install -d -m 0700 /etc/credstore
if [ -f "$CREDENTIALS" ]; then
    /usr/lib/pandora-box/bin/python3 - "$CREDENTIALS" <<'PYTHON'
import os
import sys
import tomllib

with open(sys.argv[1], "rb") as f:
    credentials = tomllib.load(f)

def install(name, value, what):
    path = f"/etc/credstore/pandora-box.{name}"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value.strip() + "\n")
    print(f"{what} installed as a credential")


key = credentials.get("abusech", {}).get("auth_key", "")
if key:
    install("abusech-auth-key", key, "abuse.ch Auth-Key (update service)")
# Copy of the verified keys to a server (docs/airgap.md)
airgap = credentials.get("airgap", {})
for field, name, what in (
    ("ssh_key", "airgap-ssh-key", "SSH key of the copy to a server (airgap service)"),
    ("token_key", "airgap-token-key", "key of the key identifiers (kiosk)"),
):
    if airgap.get(field, ""):
        install(name, airgap[field], what)
PYTHON
fi
