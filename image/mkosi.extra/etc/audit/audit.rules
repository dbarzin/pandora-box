## Audit rules of the kiosk (auditd, /var/log/audit/audit.log). Loaded as is
## by audit-rules.service (the root filesystem is read-only: augenrules cannot
## write this file at boot), then locked until the next boot.
## The scans read thousands of files: file reads are never audited.
-D
-b 8192
--backlog_wait_time 60000
## Failure: a message in the kernel log
-f 1

## Kernel modules (the kernel only loads signed modules: lockdown)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules

## Mounts: the kiosk mounts the USB devices, read-only then read-write to clean
## (not the private mounts of the service sandboxes, set up by systemd, and of
## bubblewrap at each start of a scan worker: hundreds at every boot). The
## first matching rule wins, and a rule takes only one exe field.
-a never,exit -F arch=b64 -S mount,umount2,move_mount,fsmount -F exe=/usr/lib/systemd/systemd-executor
-a never,exit -F arch=b32 -S mount,umount2 -F exe=/usr/lib/systemd/systemd-executor
-a never,exit -F arch=b64 -S mount,umount2,move_mount,fsmount -F exe=/usr/lib/systemd/systemd
-a never,exit -F arch=b32 -S mount,umount2 -F exe=/usr/lib/systemd/systemd
-a never,exit -F arch=b64 -S mount,umount2,move_mount,fsmount -F exe=/usr/bin/bwrap
-a never,exit -F arch=b32 -S mount,umount2 -F exe=/usr/bin/bwrap
-a always,exit -F arch=b64 -S mount,umount2,move_mount,fsmount -k mount
-a always,exit -F arch=b32 -S mount,umount2 -k mount

## Programs started (mount, eject, systemctl, bubblewrap... few on a kiosk)
-a always,exit -F arch=b64 -S execve,execveat -k exec
-a always,exit -F arch=b32 -S execve,execveat -k exec

## Debugging of other processes (forbidden: kernel.yama.ptrace_scope = 3)
-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace

## Changes of the system time
-a always,exit -F arch=b64 -S clock_settime,settimeofday,adjtimex -k time
-a always,exit -F arch=b32 -S clock_settime,settimeofday,adjtimex,stime -k time

## Signature sets and image updates
-w /var/lib/pandora-box-signatures -p wa -k signatures
-w /var/lib/pandora-box-image -p wa -k image-update

## Locked until the next boot
-e 2
