# A/B update of the system image (pandora_box.imageupdate): the root partition
# of the new version, staged by the kiosk from a verified image update, is
# written to the free slot. The running version is never overwritten.
[Transfer]
ProtectVersion=%A
# Verified by the kiosk (signed manifest); booted only if signed for Secure Boot
Verify=no

[Source]
Type=regular-file
Path=/var/lib/pandora-box-image/files
MatchPattern=pandora-box_@v_@u.root.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=pandora-box_@v
MatchPartitionType=root
PartitionFlags=0
ReadOnly=1
