# Units of the kiosk image. Read before the distribution presets
# (90-systemd.preset), which "systemctl preset-all" applies at build time.

enable pandora-box.service
# Online signature updates: enabled by the image profile "online"
disable pandora-box-update.timer
# Log export to a SIEM: enabled by the image profile "online"
disable pandora-box-siem.service
# Copy of the verified keys to a server: enabled by the image profile "online"
disable pandora-box-airgap.service
# clamd is started by its socket: without a signature set, it cannot start
enable clamav-daemon.socket
disable clamav-daemon.service
enable logrotate.timer
enable usbguard.service
enable nftables.service
enable auditd.service
enable audit-rules.service

# No network: signature updates come through a dedicated channel (phase 2)
disable clamav-freshclam.service
disable clamav-freshclam-once.*
disable systemd-networkd.*
disable systemd-networkd-wait-online.service
disable systemd-network-generator.service
disable systemd-resolved.service
disable systemd-timesyncd.service
disable remote-fs.target

# No login console: the kiosk owns the first console. Only the test image
# has a shell, on the virtio console (serial-getty@hvc0, from the generator).
disable getty@.service
disable getty-static.service
# Ctrl-Alt-Del is an alias of reboot.target: not enabled, so that the mask of
# ctrl-alt-del.target (mkosi.postinst.chroot) is kept
disable reboot.target

# Image updates are installed by the kiosk (pandora_box.imageupdate), which
# restarts when it is idle. The services too: a unit without preset is
# enabled, and their [Install] Also= enables the timers (the reboot one would
# restart the kiosk during a scan)
disable systemd-sysupdate.*
disable systemd-sysupdate-reboot.*

# No system or configuration extension: an image left in /var/lib/extensions
# or /var/lib/confexts would be merged over /usr or /etc at every boot, and
# outlive a compromise that dm-verity would otherwise undo at the next boot
disable systemd-sysext.*
disable systemd-confext.*

# No TPM PCR policy: the kiosk has no measured boot yet (on the ThinkCentre,
# with its TPM, these units fail at every boot)
disable systemd-pcrlock-*

# Not used on the kiosk
disable clamav-clamonacc.service
disable usbguard-dbus.service
disable systemd-homed.service
disable systemd-homed-activate.service
disable dpkg-db-backup.timer
