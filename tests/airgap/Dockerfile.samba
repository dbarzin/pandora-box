# SMB server of the airgap tests: one share, an account with a password,
# SMB 3 with encryption required.
FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends samba \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --no-create-home --shell /usr/sbin/nologin kiosk \
    && mkdir -p /srv/samba && chown kiosk: /srv/samba \
    && printf '%s\n' \
        '[global]' \
        '  server role = standalone server' \
        '  server min protocol = SMB3' \
        '  server smb encrypt = required' \
        '  map to guest = never' \
        '  log file = /dev/stdout' \
        '[transfers]' \
        '  path = /srv/samba' \
        '  read only = no' \
        '  valid users = kiosk' \
        > /etc/samba/smb.conf
CMD ["sh", "-c", "chown kiosk: /srv/samba && (cat /secrets/smb-password; cat /secrets/smb-password) | smbpasswd -s -a kiosk && exec smbd --foreground --no-process-group --debug-stdout"]
