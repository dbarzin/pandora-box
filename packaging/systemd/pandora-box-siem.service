[Unit]
Description=PandoraBox log export to a SIEM
Documentation=https://github.com/sourcentis/pandora-box/blob/main/docs/siem.md
Wants=network-online.target
After=network-online.target

[Service]
# Follows the log file of the kiosk and sends its entries to the SIEM
# ([siem] of the configuration; exits at once when it is disabled), as the
# only user besides the update service that the firewall lets out, without
# privileges. It reads the log file through the group pandora-box-log.
ExecStart=/usr/bin/pandora-box-siem
User=pandora-box-siem
Group=pandora-box-siem
SupplementaryGroups=pandora-box-log
# Position of the last entry sent
StateDirectory=pandora-box-siem
StateDirectoryMode=0700
Restart=on-failure
RestartSec=30

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
